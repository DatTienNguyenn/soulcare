{
  "info": {
    "name": "Diary API Collection",
    "description": "Complete test collection for Diary API endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Create Diary Entry",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"My First Diary Entry\",\n  \"content\": \"Today was a wonderful day. I accomplished my goals and felt productive.\",\n  \"mood\": \"HAPPY\",\n  \"tags\": [\"productive\", \"reflection\", \"gratitude\"],\n  \"status\": \"PUBLISHED\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/diaries",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "diaries"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function() {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Response contains diary ID\", function() {",
              "  var jsonData = pm.response.json();",
              "  pm.expect(jsonData.id).to.exist;",
              "});",
              "",
              "pm.test(\"Mood is saved correctly\", function() {",
              "  var jsonData = pm.response.json();",
              "  pm.expect(jsonData.mood).to.equal(\"HAPPY\");",
              "});",
              "",
              "pm.environment.set(\"diaryId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Get All Diaries",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/diaries",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "diaries"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function() {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response is an array\", function() {",
              "  var jsonData = pm.response.json();",
              "  pm.expect(jsonData).to.be.an('array');",
              "});",
              "",
              "pm.test(\"Array contains at least one diary\", function() {",
              "  var jsonData = pm.response.json();",
              "  pm.expect(jsonData.length).to.be.greaterThan(0);",
              "});",
              "",
              "pm.test(\"Each diary has required fields\", function() {",
              "  var jsonData = pm.response.json();",
              "  jsonData.forEach(function(diary) {",
              "    pm.expect(diary.id).to.exist;",
              "    pm.expect(diary.title).to.exist;",
              "    pm.expect(diary.content).to.exist;",
              "    pm.expect(diary.mood).to.exist;",
              "  });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Get Single Diary",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/diaries/{{diaryId}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "diaries", "{{diaryId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function() {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response ID matches request ID\", function() {",
              "  var jsonData = pm.response.json();",
              "  pm.expect(jsonData.id).to.equal(pm.environment.get(\"diaryId\"));",
              "});",
              "",
              "pm.test(\"Diary has complete structure\", function() {",
              "  var jsonData = pm.response.json();",
              "  pm.expect(jsonData).to.have.all.keys(",
              "    'id', 'patientId', 'title', 'content', 'mood', 'hashtag', 'status', 'createdAt', 'lastUpdate'",
              "  );",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Update Diary Entry",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Updated Diary Entry - Improved\",\n  \"content\": \"This entry has been updated with more reflections and insights from the day.\",\n  \"mood\": \"EXCITED\",\n  \"tags\": [\"updated\", \"growth\", \"learning\"],\n  \"status\": \"PUBLISHED\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/diaries/{{diaryId}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "diaries", "{{diaryId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function() {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Title was updated\", function() {",
              "  var jsonData = pm.response.json();",
              "  pm.expect(jsonData.title).to.equal(\"Updated Diary Entry - Improved\");",
              "});",
              "",
              "pm.test(\"Mood was updated\", function() {",
              "  var jsonData = pm.response.json();",
              "  pm.expect(jsonData.mood).to.equal(\"EXCITED\");",
              "});",
              "",
              "pm.test(\"Update timestamp changed\", function() {",
              "  var jsonData = pm.response.json();",
              "  pm.expect(jsonData.lastUpdate).to.not.equal(jsonData.createdAt);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Get Diaries by Date Range",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/diaries/range?startDate=2026-05-01T00:00:00&endDate=2026-05-02T23:59:59",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "diaries", "range"],
          "query": [
            {
              "key": "startDate",
              "value": "2026-05-01T00:00:00"
            },
            {
              "key": "endDate",
              "value": "2026-05-02T23:59:59"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function() {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response is an array\", function() {",
              "  var jsonData = pm.response.json();",
              "  pm.expect(jsonData).to.be.an('array');",
              "});",
              "",
              "pm.test(\"All diaries are within date range\", function() {",
              "  var jsonData = pm.response.json();",
              "  var startDate = new Date(\"2026-05-01T00:00:00\");",
              "  var endDate = new Date(\"2026-05-02T23:59:59\");",
              "  ",
              "  jsonData.forEach(function(diary) {",
              "    var diaryDate = new Date(diary.createdAt);",
              "    pm.expect(diaryDate.getTime()).to.be.greaterThanOrEqual(startDate.getTime());",
              "    pm.expect(diaryDate.getTime()).to.be.lessThanOrEqual(endDate.getTime());",
              "  });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Delete Diary Entry",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/diaries/{{diaryId}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "diaries", "{{diaryId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 204\", function() {",
              "  pm.response.to.have.status(204);",
              "});",
              "",
              "pm.test(\"Response has no body\", function() {",
              "  pm.expect(pm.response.text()).to.be.empty;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "7. ERROR - Invalid Mood Value",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Test Entry\",\n  \"content\": \"This has an invalid mood\",\n  \"mood\": \"INVALID_MOOD\",\n  \"tags\": [],\n  \"status\": \"PUBLISHED\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/diaries",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "diaries"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400\", function() {",
              "  pm.response.to.have.status(400);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "8. ERROR - Diary Not Found",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/diaries/invalid-uuid-123",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "diaries", "invalid-uuid-123"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 404\", function() {",
              "  pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "9. ERROR - Unauthorized Request",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/diaries",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "diaries"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 401\", function() {",
              "  pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "jwt_token",
      "value": "<your_jwt_token_here>"
    },
    {
      "key": "diaryId",
      "value": ""
    }
  ]
}
